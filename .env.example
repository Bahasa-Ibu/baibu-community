# Copy to .env for local development: cp .env.example .env
# Every variable is documented in docs/developer/configuration.md.

# --- Django -------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-for-anything-but-local-development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Local development prints emails to the django container log.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Comma-separated "Name <email>" entries that receive operational emails.
DJANGO_ADMINS=

# --- Your platform (white-label) ----------------------------------------------
PLATFORM_NAME=Community Language Platform
PLATFORM_TAGLINE=Share your language, with consent, and help build tools that speak it.
PLATFORM_CONTACT_EMAIL=
PLATFORM_DOMAIN=localhost:8000
# Any CSS colour, for example #7c3aed. Leave empty for the default.
PLATFORM_BRAND_COLOR=
# Language codes, comma-separated. The first-class default is English.
PLATFORM_LANGUAGES=en
PLATFORM_DEFAULT_LANGUAGE=en
# Languages Django does not ship: "code:English name:Local name;..."
PLATFORM_EXTRA_LANGUAGES=
# Profile fields a user must fill in before continuing (name, city, country).
PROFILE_REQUIRED_FIELDS=name

# --- Phone sign-in (docs/developer/phone-sign-in.md) -------------------------
# Off by default. The console provider writes texts (and codes) to the log.
PHONE_SIGN_IN_ENABLED=False
PHONE_SIGN_UP_REQUIRED=False
MESSAGING_PROVIDER=baibu.users.messaging.ConsoleMessagingProvider

# --- File storage (docs/developer/storage.md) ----------------------------------
# "local" or "s3" (any S3-compatible object store).
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Submissions (docs/developer/submissions.md) -----------------------------
# Cleaner after the built-in rules. RuleCleaner needs no model; LiteLLMCleaner
# uses the model you configure below.
SUBMISSION_CLEANER=baibu.submissions.cleaners.RuleCleaner
SUBMISSION_CLEANER_MODEL=
SUBMISSION_CLEANER_API_BASE=
SUBMISSION_CLEANER_API_KEY=

# --- Chat (docs/developer/chat.md) -------------------------------------------
# "mock" works without a model. Configure real models in the admin.
CHAT_MODEL=mock
# Web search for the assistant (empty: off). No provider is bundled.
CHAT_SEARCH_PROVIDER=

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=baibu
POSTGRES_USER=baibu
POSTGRES_PASSWORD=baibu
DATABASE_URL=postgres://baibu:baibu@postgres:5432/baibu

# --- Valkey (Redis-compatible cache and Celery broker) ------------------------
REDIS_URL=redis://valkey:6379/0

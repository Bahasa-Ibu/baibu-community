# Copy to .env for local development: cp .env.example .env
# Every variable is documented in docs/developer/configuration.md.

# --- Django -------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-for-anything-but-local-development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Local development prints emails to the django container log.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Comma-separated "Name <email>" entries that receive operational emails.
DJANGO_ADMINS=

# --- Your platform (white-label) ----------------------------------------------
PLATFORM_NAME=Community Language Platform
PLATFORM_TAGLINE=Share your language, with consent, and help build tools that speak it.
PLATFORM_CONTACT_EMAIL=
PLATFORM_DOMAIN=localhost:8000
# Any CSS colour, for example #7c3aed. Leave empty for the default.
PLATFORM_BRAND_COLOR=
# Language codes, comma-separated. The first-class default is English.
PLATFORM_LANGUAGES=en
PLATFORM_DEFAULT_LANGUAGE=en
# Languages Django does not ship: "code:English name:Local name;..."
PLATFORM_EXTRA_LANGUAGES=
# Profile fields a user must fill in before continuing (name, city, country).
PROFILE_REQUIRED_FIELDS=name

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=baibu
POSTGRES_USER=baibu
POSTGRES_PASSWORD=baibu
DATABASE_URL=postgres://baibu:baibu@postgres:5432/baibu

# --- Valkey (Redis-compatible cache and Celery broker) ------------------------
REDIS_URL=redis://valkey:6379/0
